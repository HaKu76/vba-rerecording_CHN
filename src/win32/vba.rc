            MENUITEM SEPARATOR
            MENUITEM "插槽 #&1",                    ID_FILE_SAVEGAME_SLOT1
            MENUITEM "插槽 #&2",                    ID_FILE_SAVEGAME_SLOT2
            MENUITEM "插槽 #&3",                    ID_FILE_SAVEGAME_SLOT3
            MENUITEM "插槽 #&4",                    ID_FILE_SAVEGAME_SLOT4
            MENUITEM "插槽 #&5",                    ID_FILE_SAVEGAME_SLOT5
            MENUITEM "插槽 #&6",                    ID_FILE_SAVEGAME_SLOT6
            MENUITEM "插槽 #&7",                    ID_FILE_SAVEGAME_SLOT7
            MENUITEM "插槽 #&8",                    ID_FILE_SAVEGAME_SLOT8
            MENUITEM "插槽 #&9",                    ID_FILE_SAVEGAME_SLOT9
